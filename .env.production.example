# Copy to .env.production. Never commit the real file.
OPENAI_API_KEY=
QUANTLAB_ENV=production
# Use a random value of at least 32 characters.
QUANTLAB_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
QUANTLAB_BOOTSTRAP_ADMIN=admin
# Production password must be at least 12 characters.
QUANTLAB_BOOTSTRAP_PASSWORD=replace-with-a-strong-admin-password
QUANTLAB_AUTH_TTL_MINUTES=480
# When the frontend is served from the same container, this may remain localhost.
QUANTLAB_CORS_ORIGINS=http://localhost:8000
