# OpenRouter uses the OpenAI-compatible API. Do not commit your real .env file.
OPENROUTER_API_KEY=
# OpenRouter model ID; override this to choose another model from your account.
QUANT_AGENT_MODEL=~openai/gpt-latest
# Optional override. Defaults to https://openrouter.ai/api/v1 when OPENROUTER_API_KEY is set.
# QUANT_AGENT_BASE_URL=https://openrouter.ai/api/v1
# QUANT_AGENT_WORKSPACE=.
QUANT_AGENT_MAX_ROUNDS=12
QUANT_AGENT_MAX_BACKTEST_RETRIES=2
